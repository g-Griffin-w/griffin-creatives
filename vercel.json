{
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node",
      "config": { "includeFiles": "api/fonts/**" }
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
