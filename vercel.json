{
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "api/fonts/**"
      }
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/send-guide-retention",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/check-replies",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/send-followups",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/send-starter-kit-drip",
      "schedule": "0 18 * * *"
    }
  ]
}
